# .env.example — Modèle des variables de la pile docker compose locale
# Copier ce fichier en ".env" (ignoré par Git) et remplacer les valeurs.
# Mot de passe : il est inséré dans une URL de connexion → éviter les
# caractères @ : / # ? % (ils la casseraient). Lettres et chiffres = sans risque.
POSTGRES_USER=leoni
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leoni_maintenance
